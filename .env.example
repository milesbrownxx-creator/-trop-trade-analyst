# Copy this file to .env and fill in values on your hosting provider.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DB_PATH=./data/trop.sqlite
SESSION_DB_DIR=./data

# Flutterwave keys from your merchant dashboard. Never put secret keys in public/index.html.
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx-X
FLW_SECRET_HASH=replace-with-a-random-webhook-secret-hash

# Market data: commercial display / redistribution plan required for a paid product.
TWELVE_DATA_API_KEY=

# Optional AI analysis. Server uses rule-based reports when this is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
